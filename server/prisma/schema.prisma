// Единственная точка правды по модели данных (секция 2 дизайна).
// Миграции и типы генерируются отсюда — три init_db*.js и папка migrations/ больше не нужны.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Строка подключения задаётся в prisma.config.ts (Prisma 7), а не здесь.
datasource db {
  provider = "postgresql"
}

enum ChatType {
  PRIVATE
  GROUP
}

enum ChatRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  MEDIA
  SYSTEM
  CALL
  ANNOUNCEMENT
}

enum CallKind {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

enum LinkPreviewStatus {
  PENDING
  READY
  FAILED
}

model User {
  id String @id @default(cuid(2))

  /// Уникален, хранится в нижнем регистре, неизменяем после регистрации.
  username     String @unique
  passwordHash String
  displayName  String
  theme        String @default("system")
  fontSize     String @default("medium")
  /// Режим оформления: "glass" | "solid". Ортогонален теме (UI-1).
  surface      String @default("glass")

  /// Файл аватара — дедуплицирован как любой другой File (секция 7).
  avatarFileId String?
  avatarFile   File?   @relation("UserAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  /// Цвет буквенного аватара (blue/violet/teal/orange/pink/green), когда фото не загружено —
  /// назначается случайно один раз при регистрации и больше не меняется, чтобы один и тот же
  /// человек не красился по-разному на разных экранах (shared/src/user.ts, AVATAR_COLOR_VALUES).
  avatarColor String @default("blue")

  /// Сервисный аккаунт Qwill, от которого приходят объявления о выпусках: не находится поиском,
  /// не добавляется в группы, не рассылает presence, и в чат с ним нельзя писать
  /// (updates/03-announcements-chat.md). Ровно одна такая запись, заводится сама при первой
  /// выдаче сессии кому угодно.
  isService Boolean @default(false)

  phone    String?   @db.VarChar(32)
  birthday DateTime? @db.Date
  bio      String?   @db.VarChar(89)

  /// "text" | "html" (shared/src/user.ts, BIO_MODE_VALUES). Указывает, что показывать вместо
  /// «О себе»: текст из bio или визитку из ProfileCard. Оба черновика живут одновременно —
  /// переключение режима ничего не стирает (R-30).
  bioMode String @default("text")

  /// "user" | "admin" (shared/src/user.ts, USER_ROLE_VALUES). Строкой, а не enum — так решено
  /// в R-30. Права читаются отсюда на каждый запрос, в access-токен роль не кладётся (R-32A).
  role String @default("user")

  /// Визитка этого пользователя выключена администратором. Глобальный рубильник всех визиток —
  /// отдельно, в AppSetting под ключом profileCardsEnabled.
  cardDisabled Boolean @default(false)

  /// Бан: ограничение доступа, а не стирание истории — сообщения и файлы остаются на месте.
  bannedAt     DateTime?
  bannedReason String?
  bannedById   String?

  /// Пароль обязан быть сменён до первого запроса к API (механика — в R-32E).
  mustChangePassword Boolean @default(false)

  supportMutedUntil DateTime?

  termsVersion    String?
  termsAcceptedAt DateTime?
  privacyVersion  String?
  signupIp        String?
  signupUserAgent String?

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  reportsFiled    Report[] @relation("ReportAuthor")
  reportsReceived Report[] @relation("ReportTarget")

  profileCard       ProfileCard?
  profileCardImages ProfileCardImage[]

  sessions           Session[]
  memberships        ChatMember[]
  messages           Message[]
  reactions          Reaction[]
  createdChats       Chat[]             @relation("ChatCreatedBy")
  pushSubscriptions  PushSubscription[]
  uploadSessions     UploadSession[]
  uploadedFiles      File[]             @relation("FileUploadedBy")
  calls              Call[]
  callParticipations CallParticipant[]
  blocksMade         Block[]            @relation("BlocksMade")
  blocksReceived     Block[]            @relation("BlocksGot")
}

model Session {
  id String @id @default(cuid(2))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// В БД только хэш refresh-токена; сам токен живёт лишь у клиента.
  refreshTokenHash String   @unique
  previousTokenHash String?
  expiresAt        DateTime
  userAgent        String?

  ip         String?
  lastSeenIp String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([previousTokenHash])
}

model Chat {
  id String @id @default(cuid(2))

  type  ChatType
  title String?

  /// Аватар группы — файл вне публичной директории, доказательство владения (sha256) проверяется
  /// так же, как для User.avatarFileId (секция 7). Для PRIVATE — null, аватар берётся у собеседника.
  avatarFileId String?
  avatarFile   File?   @relation("ChatAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)

  /// Защита от гонки при одновременном создании приватного чата с обеих сторон:
  /// "<меньший userId>:<больший userId>". Для групп — null.
  pairKey String? @unique

  createdById String?
  createdBy   User?   @relation("ChatCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  isSupportRequest Boolean @default(false)

  /// Одно закреплённое сообщение на чат (этап 6). SetNull — удаление сообщения открепляет
  /// само себя, а не роняет чат.
  pinnedMessageId Int?
  pinnedMessage   Message? @relation("ChatPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatMember[]
  messages Message[]
  calls    Call[]
}

model ChatMember {
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     ChatRole @default(MEMBER)
  joinedAt DateTime @default(now())

  /// Курсор прочтения у каждого участника отдельно (вместо messages.is_read).
  /// Непрочитанные = сообщения чата с id > lastReadMessageId от других авторов.
  lastReadMessageId Int?

  /// Уведомления по чату выключены этим участником: пуши о новых сообщениях ему не уходят,
  /// звонки приходят по-прежнему. Время, а не флаг — по той же причине, что и deletedAt:
  /// видно, когда именно заглушили.
  mutedAt DateTime?

  hiddenAt DateTime?
  clearedUpToMessageId Int?

  @@id([chatId, userId])
  @@index([userId])
}

model Message {
  /// Автоинкремент, а не cuid: по id строится курсорная пагинация,
  /// подсчёт непрочитанных и догрузка пропущенного после реконнекта.
  id Int @id @default(autoincrement())

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  /// null = автор удалил аккаунт; в ленте показывается «Удалённый аккаунт» (секция 8).
  senderId String?
  sender   User?   @relation(fields: [senderId], references: [id], onDelete: SetNull)

  /// Идентификатор клиента (генерируется при отправке): повтор после обрыва сокета
  /// не создаёт дубль — сервер возвращает уже существующую запись (секция 3).
  clientId String? @unique

  albumId String?

  type    MessageType @default(TEXT)
  content String?

  callId String?
  call   Call?   @relation(fields: [callId], references: [id], onDelete: SetNull)

  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  replyToId Int?
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")

  /// Оригинал при пересылке (этап 6) — тот же приём, что и replyTo: снимок автора берётся
  /// с оригинала на момент чтения, само сообщение при удалении оригинала не трогается.
  forwardedFromId Int?
  forwardedFrom   Message?  @relation("MessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwardedAs     Message[] @relation("MessageForward")

  editedAt  DateTime?
  /// Мягкое удаление: строка остаётся, content очищается — цитаты не рассыпаются.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  attachments   Attachment[]
  reactions     Reaction[]
  pinnedInChats Chat[]       @relation("ChatPinnedMessage")

  @@index([chatId, id])
  @@index([senderId])
  @@index([forwardedFromId])
  @@index([chatId, updatedAt])
}

model Attachment {
  id String @id @default(cuid(2))

  messageId Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileId String
  file   File   @relation("AttachmentFile", fields: [fileId], references: [id], onDelete: Restrict)

  /// Уменьшенная копия/кадр, снятые клиентом через canvas перед загрузкой (секция 7). Тоже File — тоже дедуплицируется.
  thumbnailFileId String?
  thumbnail       File?   @relation("AttachmentThumbnail", fields: [thumbnailFileId], references: [id], onDelete: SetNull)

  /// Уменьшенная копия миниатюры (512 px), уходящая в ленту вместо неё — КЭШ-14.
  previewFileId String?
  preview       File?   @relation("AttachmentPreview", fields: [previewFileId], references: [id], onDelete: SetNull)

  originalName String
  width        Int?
  height       Int?
  /// Длительность аудио/видео в миллисекундах.
  duration     Int?
  /// Амплитуды волны голосового (0..1), посчитанные клиентом (этап 7, ux-ui/07-composer.md). Пусто у остальных вложений.
  peaks        Float[] @default([])
  /// BlurHash миниатюры (КЭШ-12): пузырь окрашен в первом кадре, до любой загрузки байтов.
  blurhash     String?

  @@index([messageId])
  @@index([fileId])
  @@index([thumbnailFileId])
  @@index([previewFileId])
}

model File {
  id String @id @default(cuid(2))

  /// Дедупликация: одна физическая копия на много вложений (секция 7). Хэш того, что лежит
  /// на диске: для картинок, прошедших перекодирование, он отличается от присланного клиентом.
  sha256     String @unique
  /// Хэш того, что прислал клиент — доказательство владения содержимым (assertFileOwnershipProof)
  /// и ключ дедупликации. У записей, созданных до R-30C, равен sha256.
  sourceSha256 String?
  /// Имя на диске внутри приватной STORAGE_DIR. Наружу не отдаётся.
  storedName String
  mimeType   String
  size       BigInt

  createdAt DateTime @default(now())

  /// Кто первым загрузил этот контент — используется только для проверки права поставить
  /// файл своим аватаром (иначе можно было бы угадать id чужого приватного вложения и
  /// назначить его своим аватаром, сделав публично доступным). Дедупликации не мешает.
  uploadedByUserId String?
  uploadedBy       User?   @relation("FileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  attachments            Attachment[]  @relation("AttachmentFile")
  thumbnailOfAttachments Attachment[]  @relation("AttachmentThumbnail")
  previewOfAttachments   Attachment[]  @relation("AttachmentPreview")
  avatarOfUsers          User[]        @relation("UserAvatar")
  avatarOfChats          Chat[]        @relation("ChatAvatar")
  linkPreviews           LinkPreview[] @relation("LinkPreviewImage")

  @@index([sourceSha256])
}

model LinkPreview {
  url String @id

  status      LinkPreviewStatus @default(PENDING)
  siteName    String?
  title       String?
  description String?

  imageFileId String?
  image       File?   @relation("LinkPreviewImage", fields: [imageFileId], references: [id], onDelete: SetNull)

  fetchedAt DateTime?
  expiresAt DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([imageFileId])
}

model Reaction {
  messageId Int
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, userId, emoji])
  @@index([userId])
}

model PushSubscription {
  id String @id @default(cuid(2))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String? @unique
  p256dh   String?
  auth     String?
  fcmToken String? @unique
  /// Реализация PushProvider: "webpush" (endpoint/p256dh/auth) или "fcm" (fcmToken).
  provider String @default("webpush")

  createdAt DateTime @default(now())

  @@index([userId])
}

model UploadSession {
  id String @id @default(cuid(2))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Заявлен клиентом до передачи байтов — финальный File создаётся только после проверки реального
  /// хэша содержимого на сервере (секция 7: клиенту нельзя доверять для дедупликации/идентичности).
  sha256       String
  size         BigInt
  mimeType     String
  originalName String
  /// "message" — обычный лимит MAX_FILE_SIZE_BYTES; "avatar" — более строгий MAX_AVATAR_SIZE_BYTES и только изображения.
  purpose      String

  /// Путь к временному файлу на диске, куда дописываются чанки.
  tempPath      String
  receivedBytes BigInt @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
}

model Call {
  id String @id @default(cuid(2))

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  initiatorId String?
  initiator   User?   @relation(fields: [initiatorId], references: [id], onDelete: SetNull)

  kind   CallKind   @default(AUDIO)
  status CallStatus @default(RINGING)

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  participants CallParticipant[]
  messages     Message[]

  @@index([chatId, status])
}

model CallParticipant {
  id String @id @default(cuid(2))

  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime?
  leftAt   DateTime?

  @@unique([callId, userId])
}

/// HTML-визитка профиля: отдельная таблица, а не поле у User, потому что два мегабайта не
/// должны попадать ни в один запрос, где они не нужны — а User вложен в каждое сообщение
/// и каждую строку списка чатов (R-30). Хранится уже очищенной санитайзером.
model ProfileCard {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  html      String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Картинка внутри визитки. Имя на диске — сгенерированный storageId, никогда не имя из
/// запроса: обход по пути становится невозможным конструктивно, а не проверкой. Отображаемое
/// имя (`name`) живёт только здесь и участвует в относительном пути `img/<name>` (R-30).
model ProfileCardImage {
  id String @id @default(cuid(2))

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  storageId String
  mime      String
  width     Int
  height    Int
  bytes     Int
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

/// Глобальные переключатели, которые обязаны действовать без перезапуска сервера — потому
/// строка в базе, а не переменная окружения (R-32A). Сейчас ключ один: profileCardsEnabled.
model AppSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// Жалоба от пользователя. Одна жалоба ничего не выключает автоматически — разбирает человек.
model Report {
  id String @id @default(cuid(2))

  reporterId String
  reporter   User   @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User   @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  targetChatId    String?
  targetMessageId Int?

  /// "card" | "message" | "profile" (shared/src/admin.ts).
  kind    String
  comment String

  /// "new" | "working" | "closed".
  status     String  @default("new")
  resolution String?

  createdAt  DateTime  @default(now())
  closedAt   DateTime?
  closedById String?

  @@index([status, createdAt])
  @@index([targetUserId])
  @@index([targetChatId])
}

/// Журнал административных действий. Не редактируется и не удаляется: маршрутов PATCH/DELETE
/// нет и чистки по сроку нет — журнал, который можно почистить из панели, бесполезен ровно в
/// том случае, ради которого заведён.
model AdminAction {
  id String @id @default(cuid(2))

  adminId      String
  action       String
  targetUserId String?
  targetChatId String?

  /// Снимок имён на момент действия, а не связь: журнал обязан оставаться читаемым и после
  /// удаления аккаунта, а связь с User либо утащила бы строку каскадом, либо потребовала
  /// обнуляемого ключа. По той же причине это копия, а не join — переименование username
  /// (когда оно появится) не должно переписывать историю задним числом.
  adminUsername  String?
  targetUsername String?

  /// Сериализованный JSON до 1 КБ — колонки Json в схеме проекта нет и ради одного поля не заводится.
  detail String?

  ip        String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetUserId, createdAt])
}

/// Один выпуск приложения — одна запись; сообщения в чатах всех получателей ссылаются на неё.
/// Версии по платформам необязательны и обе уникальны: выпуск бывает асимметричным (только APK
/// или только .exe), а уникальность и есть защита от повторной рассылки той же версии (D-12).
model Announcement {
  id String @id @default(cuid(2))

  androidVersionCode Int?    @unique
  androidVersionName String?
  windowsVersionName String? @unique
  changelog          String[]

  createdAt DateTime @default(now())

  messages Message[]
}

/// Блокировка по IP — вторая мера рядом с баном аккаунта (R-32H): бан не мешает завести
/// следующий аккаунт, блокировка адреса мешает.
model IpBan {
  id String @id @default(cuid(2))

  /// Нормализованный CIDR: одиночный адрес хранится как /32 (IPv4) или /128 (IPv6),
  /// подсеть — как /24 или /64. Уникален: повторная блокировка того же диапазона
  /// продлевает существующую запись, а не заводит вторую.
  cidr String @unique

  reason String

  /// null — бессрочно. Истёкшие записи не удаляются: журнал того, кого и за что
  /// блокировали, полезнее чистой таблицы.
  expiresAt DateTime?

  createdAt         DateTime @default(now())
  createdById       String
  createdByUsername String?

  liftedAt         DateTime?
  liftedById       String?
  liftedByUsername String?

  @@index([expiresAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksGot", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}
