# --- Общее ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Сервер ---
PORT=3000
# Список через запятую: браузер может открыть dev-сервер и как localhost, и как 127.0.0.1
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,app://qwill

# --- Домены (R-30) ---
# APP_ORIGIN — сам мессенджер, из него собирается frame-ancestors документа визитки.
# CARD_ORIGIN — песочница HTML-визиток: обязан отличаться от APP_ORIGIN хостом, на этом
# держится вся изоляция пользовательского кода. Локально *.localhost браузер резолвит
# в 127.0.0.1 сам, hosts править не нужно; на контурах домен смотрит на то же приложение,
# маршрутизация по Host (deploy/Caddyfile.qwill).
#   прод: APP_ORIGIN=https://qwill.mooo.com       CARD_ORIGIN=https://qwillsandbox.mooo.com
#   dev:  APP_ORIGIN=https://dev.qwill.mooo.com   CARD_ORIGIN=https://devsandbox.qwill.mooo.com
APP_ORIGIN=http://localhost:5173
CARD_ORIGIN=http://qwillsandbox.localhost:3000

# --- База данных ---
DATABASE_URL=postgresql://messenger:messenger@localhost:5432/messenger?schema=public

# --- Токены ---
# Минимум 32 символа. Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12
ADMIN_TICKET_TTL_MINUTES=15

# --- Файлы (секция 7 дизайна) ---
STORAGE_DIR=./storage
MAX_FILE_SIZE_BYTES=2147483648
MAX_AVATAR_SIZE_BYTES=52428800
UPLOAD_CHUNK_SIZE_BYTES=5242880
STORAGE_LIMIT_GB=100
# warn — только предупреждать при 90% заполнения; evict — удалять старые невостребованные файлы
STORAGE_POLICY=warn

# --- Выпуски приложения (ОБНОВЛЕНИЯ-2) ---
# Каталог с android.json и APK рядом с ним; заполняется `npm run release:manifest`
# на машине сборки, содержимое копируется на сервер и в репозиторий не попадает.
# На проде — абсолютный путь в shared/ (/var/www/message/shared/app-releases), как и
# STORAGE_DIR: внутри каталога выпуска APK стирался бы при каждом деплое.
# Не путать с /var/www/message/releases — там лежат выпуски самого кода.
APP_RELEASE_DIR=./app-releases

# --- Push-уведомления (секция 9) ---
# Сгенерировать: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@messenger.local
# Ключ сервисного аккаунта Firebase (JSON) одной строкой — Android-оболочка, шаг 10А.
# Firebase Console → Project settings → Service accounts → Generate new private key.
FCM_SERVICE_ACCOUNT_JSON=

# --- Объявления об обновлениях (ОБНОВЛЕНИЯ-3) ---
# Секрет для `npm run announce` — рассылки объявления о выпуске в чат Qwill. Не короче 16
# символов; пусто — маршрут /api/app/announce выключен целиком.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ANNOUNCE_TOKEN=

# --- Уведомления администратора в Telegram (R-32F) ---
# Все три опциональны: без токена отправка тихо пропускается, сервер работает как раньше.
# Завести бота: @BotFather → /newbot → получить токен. Написать боту любое сообщение, потом
# взять chat_id из https://api.telegram.org/bot<TOKEN>/getUpdates (result[0].message.chat.id).
# dev и прод — два РАЗНЫХ бота с разными токенами, не один на оба контура.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_NOTIFY_ENABLED=false

# --- Клиент (Vite) ---
# Пусто — клиент сам берёт хост текущей страницы (localhost/127.0.0.1/LAN-адрес телефона),
# см. client/src/api/client.ts. Задайте явно, только если API живёт на другом хосте, чем клиент.
VITE_API_URL=
# Тот же ключ, что и VAPID_PUBLIC_KEY выше — клиенту нужен публичный ключ для pushManager.subscribe.
VITE_VAPID_PUBLIC_KEY=

# --- docker-compose (используется только если поднимаете Postgres в Docker) ---
POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger
POSTGRES_DB=messenger
POSTGRES_PORT=5432

# --- OG-превью ссылок (PM-8) ---
# Единственное место, откуда сервер сам ходит на чужие адреса. Значения по умолчанию годятся
# как есть; менять имеет смысл только потолок исходящих обращений в минуту на весь сервер.
LINK_PREVIEW_TIMEOUT_MS=5000
LINK_PREVIEW_PAGE_MAX_BYTES=524288
LINK_PREVIEW_IMAGE_MAX_BYTES=5242880
LINK_PREVIEW_IMAGE_MAX_DIMENSION=800
LINK_PREVIEW_MAX_REDIRECTS=3
LINK_PREVIEW_FETCHES_PER_MINUTE=60
LINK_PREVIEW_TTL_HOURS=24
LINK_PREVIEW_FAILED_TTL_MINUTES=60
LINK_PREVIEW_MAX_ATTEMPTS=3
LINK_PREVIEW_USER_AGENT=QwillLinkPreview/1.0

# --- Звонки (LiveKit) ---
# Ключ и секрет генерируются вручную при развёртывании, см. infra/livekit/README.md
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Клиенту достаётся только URL: секрет на клиент не попадает никогда
VITE_LIVEKIT_URL=wss://livekit.example.com
# Через сколько мс неотвеченный звонок сам становится пропущенным. e2e (playwright.config.ts)
# переопределяет это на 3000 для дев-сервера, поднятого под тесты, — см. calls/12-e2e.md.
CALL_MISSED_TIMEOUT_MS=45000
