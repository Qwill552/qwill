    "@capacitor/push-notifications": "^8.1.2",
    "@messenger/shared": "*",
    "@noble/hashes": "^1.8.0",
    "idb": "^7.1.1",
    "livekit-client": "^2.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "vite": "^8.2.0",
    "vite-plugin-mkcert": "^2.1.0",
