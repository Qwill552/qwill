qwill.mooo.com {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		root * /var/www/message/current/client/dist

		# Единственная директива CSP на странице приложения: встроить в неё кадром можно только
		# домен песочницы визиток и больше ничего (R-30, Граница 1). Директив без default-src
		# намеренно ровно одна — политика ограничивает кадры и не трогает остальное.
		#
		# Стоит внутри handle статики, а НЕ на уровне сайта: на уровне сайта заголовок
		# оборачивает ResponseWriter и для /socket.io/*, где соединение хайджекается под
		# WebSocket. Апгрейд при этом проходит и тут же рвётся, а висящий polling с тем же
		# sid получает 400 — сессии на сервере уже нет.
		header Content-Security-Policy "frame-src https://qwillsandbox.mooo.com"

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@static path /fonts/* /emoji/* /wallpaper/*
		header @static Cache-Control "public, max-age=86400"

		@nocache path / /index.html /sw.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache, must-revalidate"

		try_files {path} /index.html
		file_server
	}
}

# Песочница визиток. Отдельный origin — на нём держится вся изоляция пользовательского HTML
# (R-30, Граница 0). Сюда уходит весь трафик хоста целиком: приложение само разбирает Host
# и подключает отдельный роутер до всей цепочки аутентификации, так что статики здесь нет
# и API здесь нет.
qwillsandbox.mooo.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}
